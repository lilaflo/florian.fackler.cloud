---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang?: string;
  canonical?: string;
}

const { title, description, lang = "de", canonical } = Astro.props;
const baseUrl = "https://fackler-it.ch";
const isDe = lang !== "en";
const ogLocale = isDe ? "de_CH" : "en_GB";
const ogLocaleAlternate = isDe ? "en_GB" : "de_CH";
const canonicalUrl = canonical
  ? `${baseUrl}${canonical}`
  : isDe
    ? `${baseUrl}/`
    : `${baseUrl}/en/`;
const ogImage = `${baseUrl}/og-image.png`;
const logoUrl = `${baseUrl}/assets/florian-fackler-logo.png`;

// Localized strings for OG / Twitter / JSON-LD
const copy = isDe
  ? {
      ogTitle: "Florian Fackler | KI-Automatisierung für Schweizer KMU",
      ogDescription:
        "Datenschutzkonforme KI-Automatisierung für Schweizer KMU. Workflows, Dokumente, Assistenten. Deine Daten bleiben in der Schweiz.",
      orgDescription:
        "Datenschutzkonforme KI-Automatisierung für Schweizer KMU.",
      serviceDescription:
        "KI-Automatisierung für Schweizer KMU. Datenschutzkonforme Dokumentenverarbeitung, Workflow-Automatisierung und intelligente Assistenten.",
      webPageName: "Florian Fackler | KI-Automatisierung für Schweizer KMU",
      webPageDescription:
        "Datenschutzkonforme KI-Automatisierung für Schweizer KMU. Workflows, Dokumente, Assistenten. Deine Daten bleiben in der Schweiz.",
      inLanguage: "de-CH",
      serviceTypes: [
        "KI-Lösungen",
        "Systeme & Strategie",
        "Online-Shops",
        "Interim IT-Leitung",
      ],
      offers: [
        {
          name: "Vor-Ort-Analyse",
          description:
            "Eintägige Vor-Ort-Analyse deiner Prozesse mit KI-Optimierungspotenzialen, mehrseitigem Hand-Out und Einschätzung der Umsetzungsdauer pro Position.",
          price: "750",
          priceMax: "750",
        },
      ],
      faq: [
        {
          q: "Was kostet KI-Automatisierung für ein Schweizer KMU?",
          a: "Der Einstieg ist ein kostenloses 30-minütiges Erstgespräch. Danach folgt eine eintägige Vor-Ort-Analyse für CHF 750, die bei Projektstart angerechnet wird. Die Umsetzung startet ab CHF 3'000, monatlicher Support ab CHF 1'000. Der Stundensatz liegt ab CHF 150.",
        },
        {
          q: "Bleiben meine Daten wirklich in der Schweiz?",
          a: "Ja. Die Systeme laufen entweder vor Ort bei dir im Betrieb oder in Schweizer Rechenzentren. Nichts geht ins Ausland, nichts verlässt die Schweiz. Das ist DSG-konform und unterscheidet uns von Anbietern, die Daten in US-Clouds verarbeiten.",
        },
        {
          q: "Für welche Branchen arbeitet Fackler IT-Solutions?",
          a: "Für Schweizer KMU mit 1 bis 50 Mitarbeitern, besonders Online-Shops, Treuhänder, Dienstleistungen und Industrie. Konkrete Referenzen gibt es bei Shirtinator AG und Ten Guitars GmbH.",
        },
        {
          q: "Was ist der KI-Wissens-Check?",
          a: "Ein strukturiertes Diagnose-Gespräch, das zeigt, wo KI in deinem Betrieb tatsächlich Zeit und Geld spart. Es ist der Einstieg in die Zusammenarbeit und wird bei einem späteren Projektstart angerechnet.",
        },
      ],
    }
  : {
      ogTitle: "Florian Fackler | AI Automation for Swiss SMEs",
      ogDescription:
        "Privacy-focused AI automation for Swiss SMEs. Workflow automation, document processing, AI assistants. Your data stays in Switzerland.",
      orgDescription: "Privacy-focused AI automation for Swiss SMEs.",
      serviceDescription:
        "AI automation for Swiss SMEs. Privacy-focused document processing, workflow automation, and intelligent assistants.",
      webPageName: "Florian Fackler | AI Automation for Swiss SMEs",
      webPageDescription:
        "Privacy-focused AI automation for Swiss SMEs. Workflow automation, document processing, AI assistants.",
      inLanguage: "en",
      serviceTypes: [
        "AI Solutions",
        "Systems & Strategy",
        "Online Shops",
        "Interim IT Management",
      ],
      offers: [
        {
          name: "On-Site Analysis",
          description:
            "One-day on-site analysis of your processes with AI optimization opportunities, a multi-page handout, and estimated implementation time per item.",
          price: "750",
          priceMax: "750",
        },
      ],
      faq: [
        {
          q: "How much does AI automation cost for a Swiss SME?",
          a: "It starts with a free 30-minute initial consultation. Next is a one-day on-site analysis for CHF 750, credited toward a later project. Implementation starts at CHF 3,000, monthly support from CHF 1,000. The hourly rate is from CHF 150.",
        },
        {
          q: "Do my data really stay in Switzerland?",
          a: "Yes. Systems run either on-premises at your business or in Swiss data centers. Nothing leaves the country. This is DSG-compliant and sets us apart from providers processing data in US clouds.",
        },
        {
          q: "Which industries does Fackler IT-Solutions work with?",
          a: "Swiss SMEs with 1 to 50 employees, especially online shops, fiduciaries, services, and industry. Concrete references include Shirtinator AG and Ten Guitars GmbH.",
        },
        {
          q: "What is the AI knowledge check?",
          a: "A structured diagnostic session that shows where AI can actually save your business time and money. It is the entry point to working together and is credited toward a later project start.",
        },
      ],
    };

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${baseUrl}/#organization`,
      name: "Florian Fackler IT-Solutions",
      url: `${baseUrl}/`,
      logo: logoUrl,
      description: copy.orgDescription,
      legalName: "Florian Fackler IT-Solutions",
      foundingDate: "2026",
      vatID: "CHE-269.516.266 MWST",
      address: {
        "@type": "PostalAddress",
        streetAddress: "Tellstrasse 32",
        addressLocality: "Olten",
        postalCode: "4600",
        addressRegion: "SO",
        addressCountry: "CH",
      },
    },
    {
      "@type": "WebSite",
      "@id": `${baseUrl}/#website`,
      url: `${baseUrl}/`,
      name: "Florian Fackler IT-Solutions",
      publisher: { "@id": `${baseUrl}/#organization` },
      inLanguage: ["de-CH", "en"],
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: copy.webPageName,
      description: copy.webPageDescription,
      isPartOf: { "@id": `${baseUrl}/#website` },
      about: { "@id": `${baseUrl}/#organization` },
      inLanguage: copy.inLanguage,
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      mainEntity: copy.faq.map((item) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.a,
        },
      })),
      inLanguage: copy.inLanguage,
    },
    {
      "@type": "ProfessionalService",
      name: "Florian Fackler IT-Solutions",
      url: `${baseUrl}/`,
      description: copy.serviceDescription,
      priceRange: "CHF 150/h – CHF 30,000/project",
      areaServed: {
        "@type": "GeoCircle",
        geoMidpoint: {
          "@type": "GeoCoordinates",
          latitude: 47.3539,
          longitude: 7.9081,
        },
        geoRadius: "80000",
      },
      serviceType: copy.serviceTypes,
      knowsAbout: [
        "Artificial Intelligence",
        "Workflow Automation",
        "Interim IT Management",
        "Data Privacy",
        "Document Processing",
        "n8n",
        "Ollama",
        "Large Language Models",
        "E-Commerce",
        "Shopware",
        "Shopify",
        "Scrum",
        "IT Strategy",
        "Digital Transformation",
      ],
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "AI Automation Packages",
        itemListElement: copy.offers.map((offer) => ({
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: offer.name,
            description: offer.description,
          },
          priceSpecification: {
            "@type": "PriceSpecification",
            minPrice: offer.price,
            maxPrice: offer.priceMax,
            priceCurrency: "CHF",
          },
        })),
      },
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

     
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/assets/favicon.ico" />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/assets/favicon-16x16.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/assets/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="48x48"
      href="/assets/favicon-48x48.png"
    />
    <link
      rel="icon"
      type="image/x-icon"
      href="/assets/favicon-dark.ico"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/assets/favicon-dark-16x16.png"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/assets/favicon-dark-32x32.png"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="48x48"
      href="/assets/favicon-dark-48x48.png"
      media="(prefers-color-scheme: dark)"
    />
    <!-- Open Graph -->
    <meta property="og:title" content={copy.ogTitle} />
    <meta property="og:description" content={copy.ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Florian Fackler" />
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={copy.ogTitle} />
        </>
      )
    }
    <!-- Twitter Card -->
    <meta
      name="twitter:card"
      content={ogImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={copy.ogTitle} />
    <meta name="twitter:description" content={copy.ogDescription} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <!-- Geo -->
    <meta name="geo.region" content="CH-SO" />
    <meta name="geo.placename" content="Olten" />
    <!-- Robots -->
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />
    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />
    <!-- Alternate languages (must match sitemap-0.xml exactly: de-CH, /en/ with trailing slash) -->
    <link rel="alternate" hreflang="de-CH" href={`${baseUrl}/`} />
    <link rel="alternate" hreflang="en" href={`${baseUrl}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${baseUrl}/`} />
    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <!-- Analytics (Umami, privacy-friendly, no cookies) -->
    <script
      defer
      src="https://imamu.code-nexus.co/script.js"
      data-website-id="519d7a56-80eb-4dae-ba6a-f531e5541f61"></script>
  </head>
  <body>
    <main>
      <slot />
    </main>

    <script is:inline>
      const htmlElement = document.documentElement;
      const prefersDark = window.matchMedia(
        "(prefers-color-scheme: dark)",
      ).matches;
      htmlElement.setAttribute("data-theme", prefersDark ? "dark" : "light");

      window
        .matchMedia("(prefers-color-scheme: dark)")
        .addEventListener("change", (e) => {
          htmlElement.setAttribute("data-theme", e.matches ? "dark" : "light");
        });

      // --- Umami event tracking: section visibility + contact dialog ---
      function trackEvent(name, props) {
        if (window.umami && typeof window.umami.track === "function") {
          window.umami.track(name, props || {});
        }
      }

      // Track section visibility (scroll depth)
      var trackedSections = {};
      var sectionObserver = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting && !trackedSections[entry.target.id]) {
            trackedSections[entry.target.id] = true;
            trackEvent("section-view", { section: entry.target.id });
          }
        });
      }, { threshold: 0.3 });

      document.querySelectorAll("section[id]").forEach(function (s) {
        sectionObserver.observe(s);
      });

      // Track contact dialog open/close
      var dialogEl = document.getElementById("contactDialog");
      if (dialogEl) {
        var origOpen = window.openContactDialog;
        window.openContactDialog = function () {
          trackEvent("contact-dialog-open");
          if (origOpen) origOpen.apply(this, arguments);
        };

        dialogEl.addEventListener("close", function () {
          var form = document.getElementById("contactForm");
          if (form && form.hidden) {
            trackEvent("contact-form-submitted");
          } else {
            trackEvent("contact-dialog-close");
          }
        });
      }
    </script>
  </body>
</html>
