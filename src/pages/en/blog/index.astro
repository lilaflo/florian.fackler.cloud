---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import ContactDialog from "../../../components/ContactDialog.astro";
import en from "../../../i18n/locales/en/index.json";

const posts = (await getCollection("blog", ({ data }) => data.lang === "en"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Blog | Florian Fackler | AI Automation for Swiss SMEs"
  description="Practical articles on AI automation for Swiss SMEs: workflows, data privacy, online shops. Your data stays in Switzerland."
  lang="en"
  canonical="/en/blog/"
>
  <Header lang="en" />
  <main class="blog-list container">
    <h1>Blog</h1>
    <p class="blog-list-intro">
      Practical articles on AI automation for Swiss SMEs. Your data stays in Switzerland.
    </p>
    <ul class="blog-list-items">
      {posts.map((post) => (
        <li>
          <a href={`/en/blog/${post.id}/`}>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" })}
            </time>
          </a>
        </li>
      ))}
    </ul>
  </main>
  <ContactDialog t={en} lang="en" />
  <Footer lang="en" />
</Layout>
