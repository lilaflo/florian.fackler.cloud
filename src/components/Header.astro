---
interface Props {
  lang?: string;
}

const { lang = "de" } = Astro.props;

const navItems =
  lang === "de"
    ? [
        { label: "Referenzen", href: "#references" },
        { label: "Branchen", href: "#industries" },
        { label: "Leistungen", href: "#services" },
        { label: "Preise", href: "#tripwire" },
        { label: "Blog", href: "/blog/" },
        { label: "Kontakt", href: "#contact" },
      ]
    : [
        { label: "References", href: "#references" },
        { label: "Industries", href: "#industries" },
        { label: "Services", href: "#services" },
        { label: "Pricing", href: "#tripwire" },
        { label: "Blog", href: "/en/blog/" },
        { label: "Contact", href: "#contact" },
      ];
---

<header>
  <div class="container header-flex">
    <a href={lang === "en" ? "/en" : "/"} class="logo" data-umami-event="logo-click">
      <span class="name">Fackler</span>
      <span class="accent bold">IT-Solutions</span>
    </a>
    <nav>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} data-umami-event="nav-click" data-umami-event-target={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
