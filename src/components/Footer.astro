---
interface Props {
  lang?: string;
}

const { lang = 'de' } = Astro.props;

const year = new Date().getFullYear();

const translations = {
  en: {
    name: 'Florian Fackler',
    company: 'Fackler IT-Solutions',
    companyAddon: 'Einzelfirma, eingetragen im Handelsregister des Kantons Solothurn',
    address: 'Bumelochstr. 35',
    zipCity: '4656 Starrkirch-Wil',
    canton: 'Solothurn',
    country: 'Switzerland',
    uid: 'CHE-269.516.266',
    rights: 'All rights reserved.',
    services: 'AI Solutions • Systems & Strategy • Online Shops • Interim IT Leadership',
    swissQuality: 'Swiss Quality',
    podcast: 'Podcast: AI Daily News',
  },
  de: {
    name: 'Florian Fackler',
    company: 'Fackler IT-Solutions',
    companyAddon: 'Einzelfirma, eingetragen im Handelsregister des Kantons Solothurn',
    address: 'Bumelochstr. 35',
    zipCity: '4656 Starrkirch-Wil',
    canton: 'Solothurn',
    country: 'Schweiz',
    uid: 'CHE-269.516.266',
    rights: 'Alle Rechte vorbehalten.',
    services: 'KI-Lösungen • Systeme & Strategie • Online-Shops • Interim IT-Leitung',
    swissQuality: 'Swiss Quality',
    podcast: 'Podcast: AI Daily News',
  },
};

const applePodcastsUrl = 'https://podcasts.apple.com/us/podcast/ai-daily-news/id6780972277';

const t = translations[lang as keyof typeof translations] || translations.en;
---

<footer>
  <div class="container">
    <div class="footer-top">
      <div class="footer-col footer-brand">
        <p class="footer-name">{t.name}</p>
        <p class="footer-company">{t.company}</p>
        
      </div>

      <div class="footer-col footer-address">
        <p>{t.address}</p>
        <p>{t.zipCity}</p>
        <p>{t.canton} – {t.country}</p>
      </div>

      <div class="footer-col footer-services">
        <p>{t.services}</p>
        <p><a href={applePodcastsUrl} target="_blank" rel="noopener noreferrer" class="footer-podcast-link" data-umami-event="footer-podcast-click">{t.podcast}</a></p>
      </div>
    </div>

    <div class="footer-divider"></div>

    <div class="footer-bottom-row">
      <div class="footer-legal">
        <p class="footer-company-addon">{t.companyAddon} ● UID {t.uid}</p>
        <p>&copy; {year} {t.name}. {t.rights}</p>
      </div>

      <div class="footer-bottom-right">
        <a href="/trust/" class="footer-trust-link">{lang === 'de' ? 'Datenschutz' : 'Privacy'}</a>
        <div class="lang-switch">
          <a href="/en" class:list={[{ active: lang === 'en' }]} data-umami-event="lang-switch" data-umami-event-target="en">EN</a>
          <span>|</span>
          <a href="/" class:list={[{ active: lang === 'de' }]} data-umami-event="lang-switch" data-umami-event-target="de">DE</a>
        </div>
        <div class="trust-element">
          <span>{t.swissQuality}</span>
          <svg
            width="20"
            height="20"
            viewBox="0 0 32 32"
            xmlns="http://www.w3.org/2000/svg"
            aria-label="Swiss flag"
          >
            <rect width="32" height="32" fill="var(--accent)"></rect>
            <rect x="6" y="13" width="20" height="6" fill="var(--white)"></rect>
            <rect x="13" y="6" width="6" height="20" fill="var(--white)"></rect>
          </svg>
        </div>
      </div>
    </div>
  </div>
</footer>
