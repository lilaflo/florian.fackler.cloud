---
interface Props {
  lang?: string;
  t: {
    form_title: string;
    form_name_label: string;
    form_name_placeholder: string;
    form_email_label: string;
    form_email_placeholder: string;
    form_desc_label: string;
    form_desc_placeholder: string;
    form_submit: string;
    form_sending: string;
    form_success: string;
    form_error: string;
  };
}

const { t, lang = "de" } = Astro.props;
---

<div
  class="contact-overlay"
  id="contactOverlay"
  onclick="closeContactDialog(event)"
>
  <dialog id="contactDialog" onclick="event.stopPropagation()">
    <div class="contact-dialog-header">
      <h2>{t.form_title}</h2>
      <button
        class="contact-dialog-close"
        onclick="closeContactDialog()"
        aria-label="Close"
      >
        &times;
      </button>
    </div>
    <div class="contact-dialog-body">
      <form id="contactForm" novalidate>
        <div class="contact-field">
          <label for="contact-name">{t.form_name_label}</label>
          <input
            type="text"
            id="contact-name"
            name="name"
            placeholder={t.form_name_placeholder}
            required
            autocomplete="name"
          />
        </div>
        <div class="contact-field">
          <label for="contact-email">{t.form_email_label}</label>
          <input
            type="email"
            id="contact-email"
            name="email"
            placeholder={t.form_email_placeholder}
            required
            autocomplete="email"
          />
        </div>
        <div class="contact-field">
          <label for="contact-desc">{t.form_desc_label}</label>
          <textarea
            id="contact-desc"
            name="description"
            placeholder={t.form_desc_placeholder}
            rows="4"
          ></textarea>
        </div>
        <button type="submit" class="btn contact-submit" id="contactSubmit" data-sending={t.form_sending}>
          <span>{t.form_submit}</span>
        </button>
      </form>
      <div class="contact-status" id="contactStatus" hidden data-ok={t.form_success} data-error={t.form_error}></div>
    </div>
  </dialog>
</div>

<script is:inline>
  var contactOverlay = document.getElementById("contactOverlay");
  var contactDialog = document.getElementById("contactDialog");
  var contactForm = document.getElementById("contactForm");
  var contactSubmit = document.getElementById("contactSubmit");
  var contactStatus = document.getElementById("contactStatus");

  var submitLabel = contactSubmit ? contactSubmit.textContent.trim() : "";

  window.openContactDialog = function () {
    if (contactOverlay) contactOverlay.classList.add("active");
    if (contactDialog) contactDialog.showModal();
    document.body.style.overflow = "hidden";
  };

  window.closeContactDialog = function (e) {
    if (e && e.target !== contactOverlay) return;
    if (contactDialog) contactDialog.close();
    if (contactOverlay) contactOverlay.classList.remove("active");
    document.body.style.overflow = "";
  };

  if (contactDialog) {
    contactDialog.addEventListener("close", function () {
      if (contactOverlay) contactOverlay.classList.remove("active");
      document.body.style.overflow = "";
    });
  }

  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape" && contactDialog && contactDialog.open) {
      window.closeContactDialog();
    }
  });

  if (contactForm) {
    contactForm.addEventListener("submit", function (e) {
      e.preventDefault();

      var name = contactForm.elements["name"].value.trim();
      var email = contactForm.elements["email"].value.trim();
      var description = contactForm.elements["description"].value.trim();

      if (!name || !email) {
        showStatus(dataStatusError, true);
        return;
      }

      if (contactSubmit) {
        contactSubmit.disabled = true;
        var span = contactSubmit.querySelector("span") || contactSubmit;
        span.textContent = contactSubmit.dataset.sending;
      }

      fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name: name, email: email, description: description, lang: document.documentElement.lang })
      })
        .then(function (res) {
          if (!res.ok) throw new Error("HTTP " + res.status);
          return res.json();
        })
        .then(function () {
          contactForm.hidden = true;
          showStatus(dataStatusOk, false);
          if (window.umami && typeof window.umami.track === "function") {
            window.umami.track("contact-dialog-success");
          }
        })
        .catch(function () {
          if (contactSubmit) {
            contactSubmit.disabled = false;
            var span = contactSubmit.querySelector("span") || contactSubmit;
            span.textContent = submitLabel;
          }
          showStatus(dataStatusError, true);
        });
    });
  }

  var dataStatusOk = contactStatus ? contactStatus.dataset.ok : "";
  var dataStatusError = contactStatus ? contactStatus.dataset.error : "";

  function showStatus(msg, isError) {
    if (!contactStatus) return;
    contactStatus.textContent = msg;
    contactStatus.hidden = false;
    contactStatus.classList.toggle("contact-status-error", isError);
    contactStatus.classList.toggle("contact-status-ok", !isError);
  }
</script>