---
interface LocaleData {
  title: string;
  description: string;
  hero_headline: string;
  hero_tagline: string;
  hero_rate: string;
  hero_avail: string;
  usp_title: string;
  usp_1_title: string;
  usp_1_text: string;
  usp_2_title: string;
  usp_2_list: string[];
  usp_3_title: string;
  usp_3_list: string[];
  references_title: string;
  references_intro: string;
  references: { client: string; project: string; result: string; tags: string[] }[];
  industries_title: string;
  industry_cards: { title: string; text: string }[];
  services_title: string;
  service_cards: { title: string; text: string; details: string[] }[];
  tripwire_badge: string;
  tripwire_title: string;
  tripwire_price: string;
  tripwire_note: string;
  tripwire_action: string;
  tripwire_details: string[];
  offers_title: string;
  offers: { step: string; title: string; price: string; desc: string; points: string[]; cta: string }[];
  alert_text: string;
  alert_cta: string;
  alert_sub: string;
  contact_cta: string;
  contact_title: string;
  contact_subtitle: string;
}

interface Props {
  t: LocaleData;
  lang: string;
}

const { t, lang } = Astro.props;
---

<section class="hero">
  <div class="container">
    <div class="hero-layout">
      <div class="hero-text">
        <h1>{t.hero_headline}</h1>
        <p set:html={t.hero_tagline} />
        <div class="hero-meta">
          <span class="hero-rate">{t.hero_rate}</span>
          <span class="hero-divider">&middot;</span>
          <span class="hero-avail" set:html={t.hero_avail} />
        </div>
        <button type="button" class="btn" onclick="openContactDialog()" data-umami-event="cta-click" data-umami-event-location="hero">
          <span>{t.contact_cta}</span>
        </button>
      </div>
      <div class="hero-photo">
        <picture>
          <source srcset="/assets/florian-fackler-portrait.avif" type="image/avif" fetchpriority="high" />
          <source srcset="/assets/florian-fackler-portrait.webp" type="image/webp" fetchpriority="high" />
          <img src="/assets/florian-fackler-portrait.avif" alt="Florian Fackler" width="280" fetchpriority="high" />
        </picture>
      </div>
    </div>
  </div>
</section>

<!-- Alert Banner -->
<div class="alert-banner" id="alertBanner">
  <div class="container alert-banner-inner">
    <div class="alert-banner-text">
      <span class="alert-banner-label">{t.alert_text}</span>
      <span class="alert-banner-sub">{t.alert_sub}</span>
    </div>
    <div class="alert-banner-actions">
      <button type="button" class="btn btn-alert mt-0" onclick="openContactDialog()" data-umami-event="cta-click" data-umami-event-location="alert-banner">
        <span>{t.alert_cta}</span>
      </button>
    </div>
  </div>
</div>

<!-- USP Section -->
<section class="section-alt">
  <div class="container">
    <h2>{t.usp_title}</h2>
    <div class="usp-grid">
      <div>
        <h3>{t.usp_1_title}</h3>
        <p set:html={t.usp_1_text.replace(/\n/g, '<br/><br/>')} />
      </div>
      <div>
        <h3>{t.usp_2_title}</h3>
        <ul>
          {t.usp_2_list.map((item: string) => <li set:html={item} />)}
        </ul>
      </div>
      <div>
        <h3>{t.usp_3_title}</h3>
        <ul>
          {t.usp_3_list.map((item: string) => <li set:html={item} />)}
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- References -->
<section id="references">
  <div class="container">
    <h2>{t.references_title}</h2>
    <p class="references-intro">{t.references_intro}</p>
    <div class="references-grid">
      {t.references.map((ref: { client: string; project: string; result: string; tags: string[] }) => (
        <div class="reference-card" data-umami-event="reference-click" data-umami-event-client={ref.client} data-umami-event-project={ref.project}>
          <div class="ref-header">
            <span class="ref-client">{ref.client}</span>
            <div class="ref-tags">
              {ref.tags.map((tag: string) => <span class="ref-tag">{tag}</span>)}
            </div>
          </div>
          <h3>{ref.project}</h3>
          <p>{ref.result}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Industries -->
<section id="industries" class="section-alt">
  <div class="container">
    <h2>{t.industries_title}</h2>
    <div class="services-grid">
      {t.industry_cards.map((card: { title: string; text: string }) => (
        <div class="service-card" data-umami-event="industry-click" data-umami-event-card={card.title}>
          <h3 set:html={card.title} />
          <p set:html={card.text} />
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Services -->
<section id="services">
  <div class="container">
    <h2>{t.services_title}</h2>
    <div class="services-grid">
      {t.service_cards.map((card: { title: string; text: string; details: string[] }) => (
        <div class="service-card" data-umami-event="service-click" data-umami-event-card={card.title}>
          <h3 set:html={card.title} />
          <p set:html={card.text} />
          <ul>
            {card.details.map((detail: string) => <li set:html={detail} />)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Offers (Funnel) -->
<section id="tripwire" class="section-tripwire">
  <div class="container">
    <h2 class="offers-heading">{t.offers_title}</h2>
    <div class="offers-grid">
      {t.offers.map((offer: { step: string; title: string; price: string; desc: string; points: string[]; cta: string }) => (
        <div class="offer-card">
          <span class="tripwire-badge">{offer.step}</span>
          <h3>{offer.title}</h3>
          <p class="tripwire-price">{offer.price}</p>
          <p class="offer-desc">{offer.desc}</p>
          <ul class="offer-points">
            {offer.points.map((point: string) => <li>{point}</li>)}
          </ul>
          <button type="button" class="btn btn-tripwire" onclick="openContactDialog()" data-umami-event="cta-click" data-umami-event-location="offer">
            <span>{offer.cta}</span>
          </button>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Contact -->
<section id="contact">
  <div class="container">
    <h2>{t.contact_title}</h2>
    <p set:html={t.contact_subtitle} />
    <br />
    <button type="button" class="btn" onclick="openContactDialog()" data-umami-event="cta-click" data-umami-event-location="contact">
      <span>{t.contact_cta}</span>
    </button>
  </div>
</section>
